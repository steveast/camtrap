#!/usr/bin/env bash
# guard — start the camera trap before leaving the room, stop it when back.
#
# A launcher, not a build artefact: it lives in ~/MEGA/os/apps alongside the other one-kilobyte
# scripts and calls the agent from its venv. Deliberately NOT a compiled binary — a PyInstaller
# bundle with OpenCV is ~200 MB, and this folder syncs to the cloud.
#
# Source of truth is the repository; install with deploy/install-guard.sh.
set -euo pipefail

REPO="${CAMTRAP_REPO:-$HOME/Dev/camtrap}"
VENV="${CAMTRAP_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/camtrap/venv}"
PY="$VENV/bin/python"

if [ ! -x "$PY" ]; then
    PY="$REPO/.venv/bin/python"
fi
if [ ! -x "$PY" ]; then
    echo "guard: no venv found." >&2
    echo "       run $REPO/deploy/install-laptop.sh first" >&2
    exit 1
fi

LOG_DIR="${CAMTRAP_LOG_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/camtrap/logs}"
LOG="$LOG_DIR/camtrap.log"

run() { PYTHONPATH="$REPO/src" "$PY" -m camtrap "$@"; }

# Long runs go through here: the terminal shows them live, the file keeps them for later. An
# overnight run whose only record is a closed scrollback cannot be reviewed at all.
run_logged() {
    mkdir -p "$LOG_DIR"
    # Keep the file bounded: 8 MB is thousands of events, and this is a laptop, not a log server.
    if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 8388608 ]; then
        mv "$LOG" "$LOG.1"
    fi
    printf '\n=== %s : camtrap %s ===\n' "$(date -Is)" "$*" >> "$LOG"
    # --log-file: the agent writes its own journal, so closing this terminal breaks neither the
    # record nor the agent. tee is only for watching it live.
    PYTHONPATH="$REPO/src" "$PY" -m camtrap --log-file "$LOG" "$@" 2>&1 | tee -a "$LOG.tty"
    rc="${PIPESTATUS[0]}"
    rm -f "$LOG.tty"
    return "$rc"
}

case "${1:-arm}" in
    arm|"")
        # The default: check everything, then arm once the room goes quiet.
        shift || true
        run_logged guard "$@"
        ;;
    off|stop)
        # Coming back for good: pause first so the poller does not report "went silent".
        run pause
        pkill -f "camtrap.*(run|guard)" 2>/dev/null || true
        echo "guard: stopped and paused"
        ;;
    status)  shift || true; run status "$@" ;;
    check)   shift || true; run preflight "$@" ;;
    drill)   shift || true; run_logged drill "$@" ;;
    watch)   shift || true; run_logged watch "$@" ;;

    # --- Telegram, over the local relay: the real tg.sh and poll.sh, no ssh ------------------
    tg-test)
        # Sends one photo through the same code path the boxes will use.
        TG_ENV="${CAMTRAP_TG_ENV:-$HOME/.config/camtrap/telegram.env}"
        [ -f "$TG_ENV" ] || { echo "guard: create $TG_ENV (chmod 600) with:";             echo "  TELEGRAM_BOT_TOKEN=..."; echo "  TELEGRAM_CHAT_ID=..."; exit 1; }
        # shellcheck disable=SC1090
        . "$TG_ENV"
        ROOT="${CAMTRAP_INBOX_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/camtrap/receiver}"
        mkdir -p "$ROOT/inbox" "$ROOT/state"
        frame=$(ls -1t "$ROOT/inbox"/evt_*.jpg 2>/dev/null | head -1 || true)
        if [ -z "$frame" ]; then
            echo "guard: no frame in $ROOT/inbox yet — run a capture first (guard --still 10)"
            exit 1
        fi
        printf '%s
%s
%s' "$TELEGRAM_BOT_TOKEN" "$TELEGRAM_CHAT_ID"             "🧪 camtrap test — $(basename "$frame") at $(date '+%H:%M:%S')" |
            CAMTRAP_ROOT="$ROOT" sh "$REPO/deploy/local-relay.sh" "send-photo $(basename "$frame")"
        ;;
    poll-loop)
        # Stands in for the Pi's cron while testing on one machine.
        shift || true
        every="${1:-120}"
        echo "guard: polling every ${every}s — Ctrl+C to stop"
        while true; do
            "$0" poll || echo "guard: poll tick failed (will retry)"
            sleep "$every"
        done
        ;;
    poll)
        # One poller tick against the local receiver: events -> Telegram, heartbeat checks.
        TG_ENV="${CAMTRAP_TG_ENV:-$HOME/.config/camtrap/telegram.env}"
        [ -f "$TG_ENV" ] || { echo "guard: create $TG_ENV first (see: guard tg-test)"; exit 1; }
        ROOT="${CAMTRAP_INBOX_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/camtrap/receiver}"
        mkdir -p "$ROOT/inbox" "$ROOT/state"
        CAMTRAP_POLL_ENV="$TG_ENV"         CAMTRAP_SSH="env CAMTRAP_ROOT=$ROOT sh $REPO/deploy/local-relay.sh"         CAMTRAP_STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/camtrap/poll-state"         CAMTRAP_TZ="${CAMTRAP_TZ:-Asia/Ho_Chi_Minh}"             sh "$REPO/deploy/pi/camtrap-poll.sh"
        ;;
    test)
        # `guard test 30` rehearses at 30 % — the first run in a flat need not be full volume.
        shift || true
        if [ $# -gt 0 ]; then
            run siren-test --volume "$1"; run warn-test --volume "$1"
        else
            echo "guard: playing at full volume — Ctrl+C to stop, or: guard test 30"
            run siren-test; run warn-test
        fi
        ;;
    sounds)  "$REPO/tools/make-siren.sh" --mode "${SIREN_MODE:-yelp}"
             exec "$REPO/tools/make-warning.sh" --all ;;
    calibrate) shift || true; run calibrate "$@" ;;
    mask)    shift || true; run mask "$@" ;;
    suggest-mask) shift || true; run suggest-mask "$@" ;;
    logs)
        # The unit logs to the journal; a hand-started run logs to the file. Show whichever exists.
        if [ -f "$LOG" ]; then
            tail -n "${2:-100}" "$LOG"
        else
            journalctl --user -t camtrap -n "${2:-100}"
        fi
        ;;
    report)  shift || true; run report --log "$LOG" "$@" ;;
    -h|--help|help)
        cat <<'USAGE'
guard — laptop camera trap

  guard              preflight, then arm when the room goes quiet, then run
  guard --still 15   arm after 15 s of quiet instead of the default 30
  guard off          stop and mark the offline as expected (do this instead of closing the window)
  guard status       mode, arming state, spool, sound readiness
  guard check        preflight only: camera, sounds, speakers, receiver, no-sleep
  guard drill        rehearse cable/mute/lid at low volume, screen stays unlocked
  guard watch [--minutes 30]  empty-room test: real detection, sound logged but silent
  guard test         play the siren and the warning at full volume
  guard test 30      rehearse the same at 30 %
  guard sounds       regenerate siren.ogg and warn-*.ogg
  guard calibrate    measure this room's noise floor, recommend a threshold
  guard mask         capture a reference frame for the ignore mask
  guard suggest-mask watch 2 min and print polygons for whatever moves on its own
  guard logs [N]     the last N log lines (file for hand-started runs, journal for the unit)
  guard report       summarise a run: events, sirens, warnings, drops, what it refused and why
  guard tg-test      send the newest captured frame to Telegram (checks the whole photo path)
  guard poll         one poller tick: new events -> Telegram with photos, heartbeat checks
  guard poll-loop [s]  keep polling every s seconds (stands in for the Pi's cron)

Leaving:  run `guard`, take your things, walk out. It arms itself once the room is still.
Coming back: unlock the screen — that disarms it. `guard off` when you are done for good.
USAGE
        ;;
    # A leading flag means "arm, with options" — `guard --still 15`, not a passthrough.
    -*) run guard "$@" ;;
    *) run "$@" ;;
esac
