# /etc/camtrap-poll.env — owned by the poller's user, mode 600. The token lives ONLY here.
TELEGRAM_BOT_TOKEN=000000:replace-me
TELEGRAM_CHAT_ID=000000000
# The receiver, reached with the Pi's own restricted key (forced command: camtrap-tg.sh)
# `IdentitiesOnly=yes` is not decoration: `-i` only ADDS an identity, so any other key configured
# or agent-held for that host can win the handshake, land in a shell instead of the forced command,
# and turn every verb into rc=127. That is what silenced the laptop's uploads for a whole afternoon.
CAMTRAP_SSH="ssh -i /home/piuser/.ssh/camtrap-pi -o BatchMode=yes -o ConnectTimeout=10 -o IdentitiesOnly=yes user@vps"
CAMTRAP_STATE_DIR=/var/lib/camtrap-poll
# Passes per cron tick, and the gap between them. cron cannot go below a minute, so an event
# otherwise waits 0-60 s before anyone looks; four passes 15 s apart cut that to 0-15 s.
POLL_PASSES=4
POLL_INTERVAL_SEC=15
# Reuse one ssh connection per pass and between ticks. Set to 0 only to debug the connection.
SSH_MULTIPLEX=1
HB_STALE_SEC=300
REPEAT_SEC=1800
TAMPER_LINK_SEC=600
CAMTRAP_TZ=Asia/Ho_Chi_Minh
# 0 = send every event. Raise above zero only if the flow becomes unusable; tamper is never capped.
MOTION_ALERTS_PER_HOUR=0
